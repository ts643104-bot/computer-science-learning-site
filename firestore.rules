rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'llwV6o2SGjUunVyphHBKiVMszX63';
    }

    function ownUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownUser(userId) || isAdmin();
      allow create: if signedIn()
        && ((isAdmin()
              && userId == request.auth.uid
              && request.resource.data.get('role', '') == 'admin')
            || (request.auth.uid == userId
              && request.resource.data.get('role', 'student') == 'student'
              && request.resource.data.get('score', 0) == 0));
      allow update: if isAdmin()
        || (ownUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastLogin', 'username']));
      allow delete: if isAdmin();
    }

    match /whitelist/{email} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /pending_requests/{email} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.token.email == email
        && request.resource.data.get('email', '') == email;
      allow update: if signedIn()
        && request.auth.token.email == email
        && resource.data.get('email', '') == email
        && request.resource.data.get('email', '') == email;
      allow delete: if isAdmin();
    }

    match /progress/{progressId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'lessonId', 'completed', 'completedAt',
          'quizCorrect', 'quizTotal', 'quizSubmittedAt'
        ]);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lessonId', 'completed', 'completedAt',
            'quizCorrect', 'quizTotal', 'quizSubmittedAt'
          ]));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment.size() <= 40;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
